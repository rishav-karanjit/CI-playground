{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "MySecurityScanner",
          "version": "1.0.0",
          "rules": [
            {
              "id": "VULN-001",
              "shortDescription": {
                "text": "Vulnerable dependency"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "VULN-001",
          "level": "error",
          "message": {
            "text": "Package foo@1.2.3 contains a known vulnerability."
          }
        }
      ]
    }
  ]
}