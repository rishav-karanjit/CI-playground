{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "DummySecurityScanner",
          "version": "1.0.0",
          "semanticVersion": "1.0.0",
          "fullName": "Dummy Security Scanner v1.0.0",
          "informationUri": "https://example.com/scanner",
          "downloadUri": "https://example.com/scanner/download",
          "organization": "Example Security",
          "language": "en-US",
          "rules": [
            {
              "id": "DUMMY-001",
              "name": "ExampleVulnerability",
              "shortDescription": {
                "text": "Example vulnerability"
              },
              "fullDescription": {
                "text": "This is a dummy security finding used to demonstrate SARIF."
              },
              "help": {
                "text": "Upgrade the affected dependency to a fixed version."
              },
              "helpUri": "https://example.com/rules/DUMMY-001",
              "defaultConfiguration": {
                "enabled": true,
                "level": "error",
                "rank": 95.0
              },
              "properties": {
                "security-severity": "9.8",
                "precision": "high",
                "tags": [
                  "security",
                  "dependency",
                  "vulnerability"
                ]
              }
            },
            {
              "id": "DUMMY-002",
              "name": "ExampleWarning",
              "shortDescription": {
                "text": "Example warning"
              },
              "fullDescription": {
                "text": "This is another dummy finding."
              },
              "defaultConfiguration": {
                "enabled": true,
                "level": "warning",
                "rank": 50.0
              }
            }
          ]
        },
        "extensions": [
          {
            "name": "DummyExtension",
            "version": "1.0",
            "semanticVersion": "1.0.0",
            "informationUri": "https://example.com/extension",
            "rules": []
          }
        ]
      },

      "invocations": [
        {
          "executionSuccessful": true,
          "commandLine": "dummy-scanner scan ./",
          "startTimeUtc": "2026-08-11T20:00:00Z",
          "endTimeUtc": "2026-08-11T20:00:10Z",
          "workingDirectory": {
            "uri": "file:///workspace/"
          },
          "exitCode": 0,
          "exitCodeDescription": "Scan completed successfully",
          "machine": "github-runner",
          "account": "github-actions",
          "environmentVariables": {
            "ENVIRONMENT": "test"
          },
          "responseFiles": [],
          "toolExecutionNotifications": [],
          "properties": {
            "checksRun": 10,
            "checksPassed": 7,
            "checksFailed": 2,
            "checksSkipped": 1
          }
        }
      ],

      "artifacts": [
        {
          "location": {
            "uri": "package.json",
            "uriBaseId": "SRCROOT"
          },
          "description": {
            "text": "Node.js package manifest"
          },
          "mimeType": "application/json",
          "roles": [
            "analysisTarget"
          ],
          "length": 512,
          "offset": 0,
          "hashes": {
            "sha-256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
          },
          "sourceLanguage": "json",
          "contents": {
            "text": "{ \"dependencies\": { \"dummy-package\": \"1.0.0\" } }"
          },
          "encoding": "utf-8",
          "properties": {
            "artifactType": "package-manifest",
            "packageManager": "npm"
          }
        },
        {
          "location": {
            "uri": "src/example.js",
            "uriBaseId": "SRCROOT"
          },
          "mimeType": "text/javascript",
          "roles": [
            "analysisTarget"
          ],
          "sourceLanguage": "javascript",
          "length": 250
        }
      ],

      "logicalLocations": [
        {
          "name": "dummy-package",
          "fullyQualifiedName": "dependencies.dummy-package",
          "kind": "dependency",
          "decoratedName": "dummy-package"
        }
      ],

      "results": [
        {
          "ruleId": "DUMMY-001",
          "ruleIndex": 0,
          "level": "error",
          "kind": "fail",
          "message": {
            "text": "dummy-package version 1.0.0 contains a critical vulnerability."
          },

          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "package.json",
                  "uriBaseId": "SRCROOT",
                  "index": 0
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 25,
                  "endLine": 1,
                  "endColumn": 48,
                  "snippet": {
                    "text": "\"dummy-package\": \"1.0.0\""
                  },
                  "sourceLanguage": "json"
                },
                "contextRegion": {
                  "startLine": 1,
                  "startColumn": 1,
                  "endLine": 1,
                  "endColumn": 55
                }
              },
              "logicalLocations": [
                {
                  "name": "dummy-package",
                  "fullyQualifiedName": "dependencies.dummy-package",
                  "kind": "dependency"
                }
              ],
              "message": {
                "text": "Vulnerable dependency declaration"
              }
            }
          ],

          "relatedLocations": [
            {
              "id": 1,
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "package.json",
                  "uriBaseId": "SRCROOT"
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 1
                }
              },
              "message": {
                "text": "Package manifest"
              }
            }
          ],

          "partialFingerprints": {
            "primaryLocationLineHash": "dummy-line-hash-001",
            "primaryLocationStartColumnFingerprint": "dummy-column-001"
          },

          "fingerprints": {
            "stableFingerprint": "dummy-stable-fingerprint-001"
          },

          "suppressions": [
            {
              "kind": "inSource",
              "status": "accepted",
              "justification": "Demonstration suppression"
            }
          ],

          "provenance": {
            "firstDetectionRunGuid": "11111111-1111-4111-8111-111111111111",
            "lastDetectionRunGuid": "22222222-2222-4222-8222-222222222222"
          },

          "baselineState": "new",

          "properties": {
            "packageName": "dummy-package",
            "installedVersion": "1.0.0",
            "fixedVersion": "1.0.1",
            "cve": "CVE-2026-00001",
            "cvss": 9.8,
            "severity": "critical"
          }
        },

        {
          "ruleId": "DUMMY-002",
          "ruleIndex": 1,
          "level": "warning",
          "kind": "review",
          "message": {
            "text": "Example warning finding."
          },

          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/example.js",
                  "uriBaseId": "SRCROOT"
                },
                "region": {
                  "startLine": 10,
                  "startColumn": 5,
                  "endLine": 10,
                  "endColumn": 20,
                  "snippet": {
                    "text": "dangerousFunction()"
                  }
                }
              }
            }
          ],

          "properties": {
            "category": "example"
          }
        }
      ],

      "automationDetails": {
        "id": "dummy-security-scan",
        "guid": "33333333-3333-4333-8333-333333333333",
        "description": {
          "text": "Dummy dependency and source security scan"
        }
      },

      "baseline": {
        "guid": "44444444-4444-4444-8444-444444444444"
      },

      "originalUriBaseIds": {
        "SRCROOT": {
          "uri": "file:///workspace/",
