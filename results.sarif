          }
        },
        "REPOROOT": {
          "uri": "https://github.com/example/example-repo/",
          "description": {
            "text": "Repository URL"
          }
        }
      },

      "taxonomies": [
        {
          "name": "ExampleSecurityTaxonomy",
          "version": "1.0",
          "organization": "Example Security",
          "shortDescription": {
            "text": "Example security classification"
          },
          "informationUri": "https://example.com/taxonomy",
          "guid": "55555555-5555-4555-8555-555555555555",
          "taxa": [
            {
              "id": "SEC-001",
              "name": "Dependency Vulnerability",
              "shortDescription": {
                "text": "Dependency vulnerability"
              }
            }
          ]
        }
      ],

      "properties": {
        "scanId": "dummy-scan-001",
        "scanType": "full",
        "scannerVersion": "1.0.0",
        "repository": "example/example-repo",
        "branch": "main",
        "commit": "abcdef1234567890",
        "checksRun": 10,
        "checksPassed": 7,
        "checksFailed": 2,
        "checksSkipped": 1,
        "artifactsScanned": 2,
        "artifactsSkipped": 0
      }
    ]
  }
}