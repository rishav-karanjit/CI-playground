{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "DummySecurityScanner",
          "version": "1.0.0",
          "rules": [
            {
              "id": "DUMMY-001",
              "name": "DummyVulnerability",
              "shortDescription": {
                "text": "Dummy dependency vulnerability"
              },
              "fullDescription": {
                "text": "A dependency in go.mod has a dummy vulnerability."
              },
              "help": {
                "text": "Upgrade the affected dependency."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },

      "artifacts": [
        {
          "location": {
            "uri": "go.mod"
          },
          "description": {
            "text": "Go module manifest"
          },
          "mimeType": "text/plain",
          "roles": [
            "analysisTarget"
          ],
          "sourceLanguage": "go",
          "properties": {
            "artifactType": "go-module",
            "packageManager": "go"
          }
        }
      ],

      "results": [
        {
          "ruleId": "DUMMY-001",
          "level": "error",
          "kind": "fail",
          "message": {
            "text": "Dummy vulnerability found in a dependency declared in go.mod."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "go.mod"
                },
                "region": {
                  "startLine": 5,
                  "startColumn": 1
                }
              },
              "message": {
                "text": "Vulnerable dependency"
              }
            }
          ],
          "properties": {
            "packageName": "example.com/dummy-package",
            "installedVersion": "v1.0.0",
            "fixedVersion": "v1.0.1",
            "severity": "high"
          }
        }
      ],

      "invocations": [
        {
          "executionSuccessful": true,
          "commandLine": "dummy-scanner scan .",
          "exitCode": 0,
          "exitCodeDescription": "Scan completed successfully",
          "properties": {
            "checksRun": 10,
            "checksPassed": 9,
            "checksFailed": 1,
            "checksSkipped": 0,
            "artifactsScanned": 1,
            "artifactsSkipped": 0
          }
        }
      ],

      "properties": {
        "scanType": "dependency",
        "scannerVersion": "1.0.0",
        "artifactsScanned": 1,
        "artifactsSkipped": 0
      }
    }
  ]
}